__pycache__/
*.py[cod]
*.db
.venv/
venv/
node_modules/
dist/
.DS_Store

# Secretos y credenciales: nunca al repositorio.
.env
# Con comodin: sin el, solo tapaba el nombre exacto y un respaldo como
# credenciales.csv.viejo-8sep se subia con los ~300 empleados dentro.
credenciales.csv*

# Datos reales que entrego Baja Gas: nombres y numeros de empleado de ~300
# personas. El repositorio es PUBLICO; esto no puede acabar ahi.
datos/
~$*

# Respaldos de la base con nombre suelto. `*.db` NO los tapa: no terminan en
# .db sino en .db.algo, y ese descuido los dejaba listos para subirse con
# toda la plantilla dentro.
*.db.*

# Claves VAPID de los avisos al celular: la privada firma como el servidor.
# Se generan solas junto a la base (backend/vapid.json en local).
vapid*.json
